<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Post</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h2>Edit your post</h2>
    <p>Post ID: <%= post.id %></p>
    <p>Post by: @<%= post.username %></p>

    <!-- Notice: method POST hai, par action ke aage ?_method=PATCH laga hai -->
    <form method="POST" action="/posts/<%= post.id %>?_method=PATCH">
        <textarea name="content" rows="6" cols="35"><%= post.content %></textarea>
        <br><br>
        <button type="submit">Update Post</button>
    </form>
</body>
</html>