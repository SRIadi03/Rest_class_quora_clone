<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Posts in detail</title>
</head>    
<body>

    <h3>Here is your post in detail</h3>
    <p>Post id: <%= post.id %></p>

    <div class="post">
        <h3 class="user">@<%= post.username %></h3>
        <h4 class="content"><%= post.content %></h4>
    </div>

    <br>
    <a href="/posts">Back to All Posts</a>
</body>
</html>